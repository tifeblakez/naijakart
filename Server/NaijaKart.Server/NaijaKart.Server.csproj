<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Authoritative race server. Hosts NaijaKart.Core simulations, owns all competitive state
    (race membership, checkpoints, laps, items, LASTMA, coins, XP, rank) and exposes them to
    clients over an ITransport. Clients only ever send inputs and intents.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NaijaKart.Server</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Build/NaijaKart.Core/NaijaKart.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NaijaKartRoot)Assets/StreamingAssets/NaijaKart/Config/**/*.json" LinkBase="Config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
