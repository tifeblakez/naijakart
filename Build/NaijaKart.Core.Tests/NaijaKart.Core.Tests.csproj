<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the EditMode NUnit tests under Assets/NaijaKart/Tests/EditMode with plain dotnet test,
    so gameplay logic is verified in CI without a Unity license. The same files run inside the
    Unity Test Runner via NaijaKart.Tests.EditMode.asmdef.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(NaijaKartRoot)Assets/NaijaKart/Tests/EditMode/**/*.cs" LinkBase="EditMode" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NaijaKart.Core/NaijaKart.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NaijaKartRoot)Assets/StreamingAssets/NaijaKart/Config/**/*.json" LinkBase="Config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
